<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>Sportykore</title>
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <![endif]-->
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&family=Playfair+Display:wght@700;900&display=swap');

      * { box-sizing: border-box; }

      body, table, td, a {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }

      table, td {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }

      img {
        -ms-interpolation-mode: bicubic;
        border: 0;
        height: auto;
        line-height: 100%;
        outline: none;
        text-decoration: none;
      }

      body {
        margin: 0 !important;
        padding: 0 !important;
        background-color: #0f0c1c;
        width: 100% !important;
        min-width: 100%;
      }

      .email-wrapper {
        background-color: #0f0c1c;
        background-image:
          linear-gradient(180deg, rgba(74,20,140,0.4) 0%, rgba(15,12,28,1) 50%),
          repeating-linear-gradient(-45deg, #0f0c1c 0 18px, rgba(230,168,23,0.06) 18px 20px);
      }

      .email-container {
        max-width: 600px;
        margin: 0 auto;
      }

      @media only screen and (max-width: 600px) {
        .email-container { width: 100% !important; }
        .content-pad { padding: 32px 24px 28px !important; }
        .header-pad { padding: 28px 24px !important; }
        .footer-pad { padding: 20px 24px !important; }
        .hero-headline { font-size: 26px !important; }
      }
    </style>
  </head>
  <body style="margin:0;padding:0;background-color:#0f0c1c;width:100%;">

    <!-- Diagonal stripe background wrapper -->
    <div class="email-wrapper" style="background-color:#0f0c1c;background-image:linear-gradient(180deg,rgba(74,20,140,0.4) 0%,rgba(15,12,28,1) 50%),repeating-linear-gradient(-45deg,#0f0c1c 0 18px,rgba(230,168,23,0.06) 18px 20px);padding:40px 16px 60px;">

      <table class="email-container" width="600" cellpadding="0" cellspacing="0" border="0" align="center" style="max-width:600px;width:100%;">

        <!-- ─── HEADER ─── -->
        <tr>
          <td style="border-radius:20px 20px 0 0;overflow:hidden;">
            <!-- Gold accent bar -->
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="height:4px;background:linear-gradient(90deg,#E6A817 0%,#F2A900 40%,#E6A817 100%);font-size:0;line-height:0;">&nbsp;</td>
              </tr>
            </table>
            <!-- Header body -->
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td
                  class="header-pad"
                  style="background:linear-gradient(145deg,#2C0C54 0%,#4A148C 60%,#3B1070 100%);padding:32px 48px 28px;text-align:center;"
                >
                  <!-- Wordmark -->
                  <div style="margin-bottom:6px;">
                    <span
                      style="font-family:'Pacifico',Georgia,serif;font-size:36px;color:#E6A817;letter-spacing:-0.5px;line-height:1;"
                    >Sportykore</span>
                  </div>
                  <!-- Tagline -->
                  <div>
                    <span
                      style="font-family:'Open Sans',Arial,Helvetica,sans-serif;font-size:10px;font-weight:700;color:rgba(255,255,255,0.5);letter-spacing:3px;text-transform:uppercase;"
                    >The League Platform</span>
                  </div>
                </td>
              </tr>
            </table>
            <!-- Separator line -->
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="height:1px;background:linear-gradient(90deg,transparent,rgba(230,168,23,0.4),transparent);font-size:0;line-height:0;">&nbsp;</td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- ─── BODY ─── -->
        <tr>
          <td
            class="content-pad"
            style="background-color:#1A1530;padding:44px 48px 40px;border-left:1px solid rgba(74,20,140,0.4);border-right:1px solid rgba(74,20,140,0.4);"
          >
            {{{ await $slots.content() }}}
          </td>
        </tr>

        <!-- ─── FOOTER ─── -->
        <tr>
          <td style="border-radius:0 0 20px 20px;overflow:hidden;">
            <!-- Top border -->
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="height:1px;background:linear-gradient(90deg,transparent,rgba(230,168,23,0.3),transparent);font-size:0;line-height:0;">&nbsp;</td>
              </tr>
            </table>
            <!-- Footer body -->
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td
                  class="footer-pad"
                  style="background:linear-gradient(180deg,#16122a 0%,#0f0c1c 100%);padding:24px 48px 28px;text-align:center;border-left:1px solid rgba(74,20,140,0.3);border-right:1px solid rgba(74,20,140,0.3);border-bottom:1px solid rgba(74,20,140,0.3);border-radius:0 0 20px 20px;"
                >
                  <!-- Logo small -->
                  <p style="margin:0 0 12px;">
                    <span style="font-family:'Pacifico',Georgia,serif;font-size:18px;color:#E6A817;">Sportykore</span>
                  </p>
                  <p style="margin:0 0 6px;font-family:'Open Sans',Arial,Helvetica,sans-serif;font-size:12px;color:rgba(255,255,255,0.3);line-height:1.6;">
                    &copy; {{ new Date().getFullYear() }} Sportykore. All rights reserved.
                  </p>
                  <p style="margin:0 0 14px;font-family:'Open Sans',Arial,Helvetica,sans-serif;font-size:11px;color:rgba(255,255,255,0.2);line-height:1.6;">
                    You received this email because you have an account with Sportykore.
                  </p>
                  <!-- Footer links -->
                  <p style="margin:0;">
                    <a href="https://sportykore.com/privacy" style="font-family:'Open Sans',Arial,Helvetica,sans-serif;font-size:11px;color:rgba(230,168,23,0.5);text-decoration:none;">Privacy Policy</a>
                    <span style="color:rgba(255,255,255,0.15);margin:0 8px;">·</span>
                    <a href="https://sportykore.com/terms" style="font-family:'Open Sans',Arial,Helvetica,sans-serif;font-size:11px;color:rgba(230,168,23,0.5);text-decoration:none;">Terms of Service</a>
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

      </table>
    </div>

  </body>
</html>
