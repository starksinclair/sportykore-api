<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>SportyKore</title>
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <![endif]-->
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&display=swap');

      * { box-sizing: border-box; }

      body, table, td, a {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }

      table, td {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }

      img {
        -ms-interpolation-mode: bicubic;
        border: 0;
        height: auto;
        line-height: 100%;
        outline: none;
        text-decoration: none;
      }

      body {
        margin: 0 !important;
        padding: 0 !important;
        background-color: #f7f5fb;
        width: 100% !important;
        min-width: 100%;
      }

      a { color: #6d3bb8; }

      .sk-wrapper { background-color: #f7f5fb; }
      .sk-card { background-color: #ffffff; border: 1px solid #e7e1f1; }
      .sk-brand { color: #4a148c; }
      .sk-brand-mark { background-color: #4a148c; color: #e6a817; }
      .sk-title { color: #171023; }
      .sk-copy { color: #4a415c; }
      .sk-muted { color: #756a86; }
      .sk-rule { background-color: #e7e1f1; }
      .sk-chip { background-color: #f3eefb; border: 1px solid #e7e1f1; }
      .sk-accent { color: #9a6a00; }
      .sk-button { background-color: #e6a817; color: #171023; }

      @media (prefers-color-scheme: dark) {
        body,
        .sk-wrapper {
          background-color: #0f0c1c !important;
        }

        .sk-card {
          background-color: #181326 !important;
          border-color: #2d2440 !important;
        }

        .sk-brand {
          color: #f1d077 !important;
        }

        .sk-brand-mark {
          background-color: #e6a817 !important;
          color: #171023 !important;
        }

        .sk-title {
          color: #ffffff !important;
        }

        .sk-copy {
          color: #ded7ea !important;
        }

        .sk-muted {
          color: #a99dbd !important;
        }

        .sk-rule {
          background-color: #2d2440 !important;
        }

        .sk-chip {
          background-color: #211934 !important;
          border-color: #332846 !important;
        }

        .sk-accent {
          color: #f1d077 !important;
        }

        .sk-button {
          background-color: #e6a817 !important;
          color: #171023 !important;
        }
      }

      [data-ogsc] body,
      [data-ogsc] .sk-wrapper {
        background-color: #0f0c1c !important;
      }

      [data-ogsc] .sk-card {
        background-color: #181326 !important;
        border-color: #2d2440 !important;
      }

      [data-ogsc] .sk-title { color: #ffffff !important; }
      [data-ogsc] .sk-copy { color: #ded7ea !important; }
      [data-ogsc] .sk-muted { color: #a99dbd !important; }
      [data-ogsc] .sk-rule { background-color: #2d2440 !important; }
      [data-ogsc] .sk-chip {
        background-color: #211934 !important;
        border-color: #332846 !important;
      }
      [data-ogsc] .sk-accent { color: #f1d077 !important; }

      @media only screen and (max-width: 600px) {
        .sk-container { width: 100% !important; }
        .sk-outer-pad { padding: 24px 12px 36px !important; }
        .sk-content-pad { padding: 28px 22px !important; }
        .sk-footer-pad { padding: 18px 22px 24px !important; }
        .sk-title { font-size: 25px !important; }
      }
    </style>
  </head>
  <body class="sk-body" style="margin:0;padding:0;background-color:#f7f5fb;width:100%;">
    <div class="sk-wrapper sk-outer-pad" style="background-color:#f7f5fb;padding:40px 16px 56px;">
      <table
        class="sk-container"
        width="600"
        cellpadding="0"
        cellspacing="0"
        border="0"
        align="center"
        style="max-width:600px;width:100%;"
      >
        <tr>
          <td style="padding:0 0 14px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td
            class="sk-card sk-content-pad"
            style="background-color:#ffffff;border:1px solid #e7e1f1;border-radius:22px;padding:36px 40px;"
          >
            {{{ await $slots.content() }}}
          </td>
        </tr>

        <tr>
          <td class="sk-footer-pad" style="padding:20px 8px 0;text-align:left;">
            <p
              class="sk-muted"
              style="margin:0 0 6px;font-family:'Open Sans',Arial,Helvetica,sans-serif;font-size:12px;color:#756a86;line-height:1.6;"
            >
              &copy; {{ new Date().getFullYear() }} SportyKore. All rights reserved.
            </p>
            <p
              class="sk-muted"
              style="margin:0 0 12px;font-family:'Open Sans',Arial,Helvetica,sans-serif;font-size:12px;color:#756a86;line-height:1.6;"
            >
              You received this email because you have a SportyKore account.
            </p>
            <p style="margin:0;font-family:'Open Sans',Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;">
              <a href="https://sportykore.com/privacy" class="sk-accent" style="color:#9a6a00;text-decoration:none;">Privacy</a>
              <span class="sk-muted" style="color:#756a86;padding:0 8px;">|</span>
              <a href="https://sportykore.com/terms" class="sk-accent" style="color:#9a6a00;text-decoration:none;">Terms</a>
            </p>
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>
